[Unit]
Description=SearXNG search engine (web search backend for Open WebUI)
After=ai-stack-network.service

[Container]
Image=docker.io/searxng/searxng:latest
AutoUpdate=registry
ContainerName=searxng
Network=ai-stack.network

Volume=%h/ai-stack/searxng:/etc/searxng:Z

#PublishPort=8080:8080

[Service]
Restart=always

# [Install]
# WantedBy=default.target

# NOTE: after first start, edit
#   ~/ai-stack/searxng/settings.yml
# and set:
#   search:
#     formats:
#       - html
#       - json
# The JSON format is off by default; Open WebUI's SearXNG integration needs it.
# Restart the service after editing: systemctl --user restart searxng.service
