# Reverse proxy for the AI stack. Two access paths are defined below —
# enable whichever fit how you connect (both can run at once):
#
#   1. Tailscale (recommended)  — real, trusted certs, works from this
#      machine, any device on your tailnet, and remotely. Commented out
#      below; see README.md > Reverse proxy (Caddy) to set it up.
#   2. LAN-only fallback        — self-signed certs via `tls internal`,
#      for devices that aren't on your tailnet. Active by default.

# =============================================================================
# 1. Tailscale access (optional — uncomment once set up)
#
# One MagicDNS hostname per device is all Tailscale gives you (no per-service
# subdomains), so each service gets its own port instead, all sharing the
# same cert. Requires TAILSCALE_HOSTNAME and the tailscale-certs volume to
# be uncommented in caddy.container too. See README.md > Reverse proxy
# (Caddy) for how to generate the cert with `tailscale cert`.
# =============================================================================

# {$TAILSCALE_HOSTNAME}:9443 {
# 	tls /tailscale-certs/tailscale.crt /tailscale-certs/tailscale.key
# 	reverse_proxy open-webui:8080
# }
#
# {$TAILSCALE_HOSTNAME}:9444 {
# 	tls /tailscale-certs/tailscale.crt /tailscale-certs/tailscale.key
# 	reverse_proxy ollama:11434
# }
#
# {$TAILSCALE_HOSTNAME}:9445 {
# 	tls /tailscale-certs/tailscale.crt /tailscale-certs/tailscale.key
# 	reverse_proxy comfyui:8188
# }
#
# {$TAILSCALE_HOSTNAME}:9446 {
# 	tls /tailscale-certs/tailscale.crt /tailscale-certs/tailscale.key
# 	reverse_proxy searxng:8080
# }
#
# {$TAILSCALE_HOSTNAME}:9447 {
# 	tls /tailscale-certs/tailscale.crt /tailscale-certs/tailscale.key
# 	reverse_proxy speaches:8000
# }

# =============================================================================
# 2. LAN-only fallback (active by default)
#
# {$DOMAIN_SUFFIX} comes from caddy.container (defaults to ai-stack.internal).
# Each client device needs to resolve these subdomains to this host's LAN
# IP — a hosts-file entry or a local DNS server — since they aren't publicly
# resolvable. `tls internal` makes Caddy mint its own local CA and issue
# self-signed certs from it, so browsers will show a one-time trust warning
# per device unless you import that CA. See README.md > Reverse proxy
# (Caddy) for both steps. Use this for devices that can't join your
# tailnet; otherwise prefer the Tailscale blocks above.
# =============================================================================

open-webui.{$DOMAIN_SUFFIX} {
	tls internal
	reverse_proxy open-webui:8080
}

ollama.{$DOMAIN_SUFFIX} {
	tls internal
	reverse_proxy ollama:11434
}

comfyui.{$DOMAIN_SUFFIX} {
	tls internal
	reverse_proxy comfyui:8188
}

searxng.{$DOMAIN_SUFFIX} {
	tls internal
	reverse_proxy searxng:8080
}

speaches.{$DOMAIN_SUFFIX} {
	tls internal
	reverse_proxy speaches:8000
}
