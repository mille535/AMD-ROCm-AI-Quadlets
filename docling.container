[Unit]
Description=Docling Serve (CPU) - document extraction + OCR for Open WebUI RAG
After=ai-stack-network.service

[Container]
Image=quay.io/docling-project/docling-serve:latest
ContainerName=docling
Network=ai-stack.network
Environment=DOCLING_SERVE_ENABLE_UI=true
# Long scanned PDFs can take minutes on CPU
Environment=DOCLING_SERVE_MAX_SYNC_WAIT=600
# Keep at 1 unless shared state (Redis) is added, otherwise "Task Not Found"
Environment=UVICORN_WORKERS=1
#PublishPort=5001:5001

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

# [Install]
# WantedBy=default.target
