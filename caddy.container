[Unit]
Description=Caddy reverse proxy (HTTPS for the AI stack)
# Only orders after the network, not the backend services — Caddy doesn't
# require any of them to be running to start. A route to a service that
# isn't up just errors (502/503) until you start it; every other route is
# unaffected. This also means Caddy can be started/enabled on its own if
# you only want one or two services from the stack running.
After=ai-stack-network.service

[Container]
Image=docker.io/library/caddy:2-alpine
AutoUpdate=registry
ContainerName=caddy
Network=ai-stack.network

# Domain suffix used by the Caddyfile's LAN-only fallback blocks (each
# service gets its own subdomain, e.g. open-webui.ai-stack.internal).
# Change this to whatever you point your client devices' DNS/hosts entries
# at. See README.md > Reverse proxy (Caddy) for DNS setup.
Environment=DOMAIN_SUFFIX=ai-stack.internal

Volume=%h/ai-stack/caddy/Caddyfile:/etc/caddy/Caddyfile:Z,ro
Volume=%h/ai-stack/caddy/data:/data:Z
Volume=%h/ai-stack/caddy/config:/config:Z

# Published on 8080/8443 by default so this works out of the box under
# rootless Podman (binding host ports below 1024 usually needs a firewall
# forwarding rule or net.ipv4.ip_unprivileged_port_start lowered first).
# See README.md > Reverse proxy (Caddy) > Serving on the standard ports
# (80/443) for both options.
PublishPort=8080:80
PublishPort=8443:443
PublishPort=8443:443/udp

# --- Tailscale access (optional, recommended) -------------------------------
# Real, trusted certs via Tailscale's HTTPS feature instead of the
# self-signed LAN fallback above — works from this machine, any device on
# your tailnet, and remotely, with no browser trust warnings. Uncomment
# these once you've generated a cert with `tailscale cert` (see README.md >
# Reverse proxy (Caddy)) and uncomment the matching blocks in the Caddyfile.
#
# Environment=TAILSCALE_HOSTNAME=myhost.tailnet-name.ts.net
# Volume=%h/ai-stack/caddy/tailscale:/tailscale-certs:Z,ro
# PublishPort=9443:9443
# PublishPort=9444:9444
# PublishPort=9445:9445
# PublishPort=9446:9446
# PublishPort=9447:9447

[Service]
Restart=always

# [Install]
# WantedBy=default.target
